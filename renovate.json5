{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  osvVulnerabilityAlerts: true,
  dependencyDashboard: {
    osvVulnerabilitySummary: "unresolved",
  },
  configMigration: true,
  timezone: "Europe/Athens",
  schedule: ["* 8-11 * * 6"],
  automerge: false,
  rangeStrategy: "bump",
  minimumReleaseAge: "3 days",
  rebaseWhen: "behind-base-branch",
  prHourlyLimit: 0,
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 8-11 * * 6"],
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["dependencies", "patch"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["dependencies", "minor"],
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["dependencies", "major"],
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "dependencies",
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["ci"],
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      groupName: "github actions",
    },
    {
      matchUpdateTypes: ["digest", "pinDigest"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      matchDatasources: ["docker"],
      minimumReleaseAge: null,
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      matchPackageNames: ["fumadocs-core", "fumadocs-ui"],
      matchUpdateTypes: ["major"],
      groupName: "fumadocs",
    },
    {
      matchManagers: ["nvm", "dockerfile"],
      matchDepNames: ["node"],
      groupName: "node runtime",
      minimumReleaseAge: null,
    },
    {
      matchDepTypes: ["peerDependencies", "engines"],
      rangeStrategy: "widen",
    },
    {
      matchManagers: ["github-actions"],
      matchPackageNames: ["actions/node-versions"],
      rangeStrategy: "replace",
    },
    {
      matchDepTypes: ["pnpm-workspace.overrides", "overrides", "resolutions"],
      groupName: "dependency overrides",
      addLabels: ["dependencies", "override"],
      rangeStrategy: "update-lockfile",
    },
  ],
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    minimumReleaseAge: null,
    rangeStrategy: "bump",
    addLabels: ["security"],
  },
}
